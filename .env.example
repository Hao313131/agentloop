# Copy to .env and edit. Every variable is optional; the defaults run fully offline.

# ---------- storage & auth ----------
AGENTLOOP_DATABASE_URL=sqlite:///./agentloop.db
# AGENTLOOP_DATABASE_URL=postgresql+psycopg://agentloop:agentloop@localhost:5432/agentloop
# With AGENTLOOP_SEED_DEMO=0 the app refuses to start on this placeholder or any secret under 32 bytes.
# Generate one: python -c 'import secrets; print(secrets.token_urlsafe(48))'
AGENTLOOP_JWT_SECRET=please-replace-with-a-long-random-string-32-bytes-min
# AGENTLOOP_AUDIT_KEY=...         # HMAC key for audit entries, required with SEED_DEMO=0 (32+ bytes, not the JWT secret); keep it apart from the database
AGENTLOOP_SEED_DEMO=1            # 0 in production: no demo tenants, no demo accounts on the login page
AGENTLOOP_SEED_DEMO_TRAFFIC=1    # pre-fill a fresh demo with a few conversations

# ---------- model ----------
# mock = deterministic offline model (no key needed, used by tests and CI)
AGENTLOOP_LLM_PROVIDER=mock
AGENTLOOP_MOCK_STREAM_DELAY=0.02

# OpenAI, Azure OpenAI, DeepSeek and Gemini share one OpenAI-compatible adapter:
# AGENTLOOP_LLM_PROVIDER=openai_compat
# AGENTLOOP_LLM_PRESET=openai            # openai | azure | deepseek | gemini (Azure needs LLM_BASE_URL)
# AGENTLOOP_LLM_BASE_URL=...             # optional: any other OpenAI-compatible endpoint
# AGENTLOOP_LLM_API_KEY=...
# AGENTLOOP_LLM_MODEL_STRONG=<model or deployment name from the provider console>
# AGENTLOOP_LLM_MODEL_FAST=<a cheaper model for simple questions>
# AGENTLOOP_LLM_STREAM_USAGE=1           # set 0 if a provider rejects stream_options

# Claude (official SDK: pip install anthropic)
# AGENTLOOP_LLM_PROVIDER=anthropic
# AGENTLOOP_LLM_API_KEY=...
# AGENTLOOP_ANTHROPIC_EFFORT=low

# Prices for the cost column, AUD per 1M tokens: {"model": [input, output]}
# AGENTLOOP_PRICES={"your-model": [0.8, 2.0]}

# ---------- embeddings ----------
AGENTLOOP_EMBEDDING_PROVIDER=hashing     # hashing (offline) | openai_compat
# AGENTLOOP_EMBEDDING_MODEL=<embedding model id>
# AGENTLOOP_EMBEDDING_DIM=1024

# ---------- agent behaviour ----------
AGENTLOOP_EVIDENCE_MODE=annotate         # annotate: stream + mark unsupported sentences | strict: buffer and block
AGENTLOOP_VERIFIER=lexical               # lexical | llm (LLM judge for paraphrasing models; number check always on)
AGENTLOOP_MIN_RELEVANCE=0.3
AGENTLOOP_MAX_AGENT_STEPS=6
AGENTLOOP_RUN_DEADLINE_SECONDS=90       # whole-run time limit; past it the customer is handed to a person
AGENTLOOP_RATE_LIMIT_PER_MINUTE=30
AGENTLOOP_LOGIN_ATTEMPTS_PER_EMAIL=10   # login attempts per account per minute
AGENTLOOP_LOGIN_ATTEMPTS_PER_IP=30      # per client IP per minute (behind a proxy: uvicorn --proxy-headers)
AGENTLOOP_RATE_LIMIT_BACKEND=auto       # login counts: database on PostgreSQL (shared by workers), memory on SQLite
AGENTLOOP_REFUND_WINDOW_DAYS=30       # refund velocity limits per customer
AGENTLOOP_REFUND_WINDOW_MAX_COUNT=3
AGENTLOOP_REFUND_WINDOW_MAX_AMOUNT=200
AGENTLOOP_ANSWER_CACHE_TTL_HOURS=24   # 0 disables the knowledge-version-aware answer cache

# AGENTLOOP_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces   # export each run as an OpenTelemetry trace (metadata only)
AGENTLOOP_PREWARM_INDEX=1              # build retrieval indexes at startup; /api/ready answers 503 until done
AGENTLOOP_TRACE_WRITES=auto             # auto: buffered on PostgreSQL, per span on SQLite | per_span | buffered

# ---------- channels ----------
# One WhatsApp Business app per tenant; an event is only accepted with that tenant's verify token
# and phone number ID, and replies go out from that tenant's number.
# AGENTLOOP_WHATSAPP_APPS={"harbour": {"phone_number_id": "...", "access_token": "...", "verify_token": "...", "app_secret": "..."}}
# AGENTLOOP_WHATSAPP_TENANT=harbour      # which tenant a callback URL without a slug belongs to
# AGENTLOOP_SLACK_WEBHOOK_URL=...        # incoming webhook for approval alerts in a Slack channel
